{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mabinogi-auction-history",
	"main": "src/index.js",
	"compatibility_date": "2025-10-20",
	"observability": {
		"enabled": true
	},

	"account_id": "57d27a287a9d78a0f12936ec68eb2d86",

	"placement": { "mode": "smart" },

	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},

	"d1_databases": [
		{
			"binding": "mabinogi_auction_db",
			"database_name": "mabinogi-auction-db",
			"database_id": "c20d5fae-2e18-49d9-9aba-1ed3248f14eb"
		}
	],

	"kv_namespaces": [
		{
			"binding": "MABINOGI_AUCTION_KV", 
			"id": "d714aa8eab7f4167a15bf3b8ce5f3764"
		}
	],
	
	"services": [
		{
			"binding": "METADATA_PROCESSOR",
			"service": "mabinogi-metadata-processor"
		}
	]
}